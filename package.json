{
  "name": "pendelum-airlines",
  "version": "1.1.0",
  "private": true,
  "description": "A physics-based flying taxi with a very lively suspended cabin.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.16.0" },
  "imports": { "#game/*": "./src/*.js" },
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/serve.js --dist",
    "check": "node scripts/check.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "verify": "npm run check && npm test && npm run build"
  }
}
